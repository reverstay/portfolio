# Copie para .env e preencha. O .env não vai para o git.

# URL pública do site (usada em metadados e links de compartilhamento)
SITE_URL=https://ramonmpm.com

# Usuário do mapa de contribuições da home
GITHUB_USERNAME=reverstay

# Formulário de contato por e-mail via Resend (https://resend.com).
# Sem RESEND_API_KEY as mensagens só aparecem em `docker compose logs app`.
RESEND_API_KEY=
CONTACT_TO_EMAIL=reversmon@gmail.com
# Precisa ser de um domínio verificado no Resend, ex.: contato@ramonmpm.com
CONTACT_FROM_EMAIL=
